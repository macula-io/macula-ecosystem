{erl_opts, [debug_info]}.
%% v1.4.30 is the first release where dist-over-relay actually survives
%% WAN latency. 1.4.29 handled local loopback but lost the first
%% post-nodeup frame under ~50 ms RTT (Hetzner).
{deps, [{macula, "~> 1.4.30"}]}.
{shell, [{apps, [dist_test]}]}.

{relx, [
    {release, {dist_test, "0.3.0"}, [dist_test]},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]}
]}.
